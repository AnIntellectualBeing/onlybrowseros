#!/bin/sh
# The MyOS screen session. startx runs this; when it ends, the screen closes.

xset s off -dpms                    # never blank the screen
xsetroot -solid '#dbeafe'           # light blue background behind everything

# The window manager: places windows by the rules in openbox.xml.
openbox --config-file /usr/share/myos/openbox.xml &

# Our bar at the bottom.
python3 /usr/lib/myos/bar.py &

# The browser. If it is closed or crashes, open it again.
while true; do
    firefox-esr
    sleep 1
done
